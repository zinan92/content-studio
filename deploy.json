{
  "_说明": "装机和更新用的依赖清单。装机脚本按它把东西拉到 path，links 里的位置建成指向它的链接；工作台的「检查更新」只更新 content-studio 自己，其余只报告装没装。别人的开源项目都用 Park 名下的副本（fork），原作者删库或闭源不影响我们；upstream 记着原作者，想同步新版本时手动 gh repo sync。",
  "app": {
    "repo": "https://github.com/zinan92/content-studio.git",
    "customer_branch": "stable"
  },
  "deps": [
    {
      "name": "content-downloader",
      "feature": "抖音作品下载、对标拆解",
      "repo": "https://github.com/zinan92/content-downloader.git",
      "ref": "main",
      "path": "~/work/content-downloader",
      "access": "public",
      "required": true
    },
    {
      "name": "content-toolkit",
      "feature": "视频号、B 站的登录和检查",
      "repo": "https://github.com/zinan92/content-toolkit.git",
      "ref": "main",
      "path": "~/content-toolkit",
      "access": "public",
      "required": true
    },
    {
      "name": "content-ops",
      "feature": "视频号、B 站、YouTube 上传",
      "repo": "https://github.com/zinan92/content-ops.git",
      "ref": "codex/workbench-p0-response-contract",
      "path": "~/work/content-ops",
      "access": "public",
      "required": true
    },
    {
      "name": "wechat-xingqiu",
      "feature": "研习室（小程序）发布，只有 Park 有",
      "repo": "https://github.com/zinan92/wechat-xingqiu.git",
      "ref": "main",
      "path": "~/work/wechat-xingqiu-shell",
      "access": "private",
      "required": false
    },
    {
      "name": "gzh-design",
      "feature": "公众号排版",
      "repo": "https://github.com/zinan92/gzh-design-skill.git",
      "ref": "main",
      "path": "~/.claude/skills/gzh-design",
      "access": "fork",
      "required": false,
      "upstream": "https://github.com/isjiamu/gzh-design-skill"
    },
    {
      "name": "ian-xiaohei-illustrations",
      "feature": "文章配图风格",
      "repo": "https://github.com/zinan92/ian-xiaohei-illustrations.git",
      "ref": "main",
      "path": "~/.agents/skill-sources/ian-xiaohei-illustrations",
      "access": "fork",
      "required": false,
      "upstream": "https://github.com/helloianneo/ian-xiaohei-illustrations",
      "links": [
        {
          "at": "~/.claude/skills/ian-xiaohei-illustrations",
          "to": "ian-xiaohei-illustrations"
        },
        {
          "at": "~/.codex/skills/ian-xiaohei-illustrations",
          "to": "ian-xiaohei-illustrations"
        }
      ]
    },
    {
      "name": "ask-park-video",
      "feature": "口播剪辑工作表",
      "repo": "https://github.com/zinan92/park-koubo-workflow.git",
      "ref": "main",
      "path": "~/.agents/skills/ask-park-video",
      "access": "public",
      "required": false
    },
    {
      "name": "video-shotcraft",
      "feature": "镜头方案检查",
      "repo": "https://github.com/zinan92/video-shotcraft.git",
      "ref": "main",
      "path": "~/.agents/skills/video-shotcraft",
      "access": "fork",
      "required": false,
      "upstream": "https://github.com/Vincentwei1021/video-shotcraft"
    }
  ]
}
